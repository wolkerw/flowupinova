rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Nega acesso a todos os documentos por padrão.
    match /{document=**} {
      allow read, write: if false;
    }

    // Permite que o próprio usuário leia seu perfil principal
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isLinkedApprover(userId));
      // Criação do perfil pelo próprio usuário: só com plano inicial (free/trial)
      // e sem nenhum atributo de privilégio, vínculo de workspace ou papel.
      allow create: if isSignedIn() && isOwner(userId)
        && !request.resource.data.keys().hasAny(privilegedKeys())
        && (!('plan' in request.resource.data) || request.resource.data.plan in ['free', 'trial'])
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['inactive', 'active'])
        && (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == 'pending_verification');
      // Atualização: o cliente nunca altera plano, pagamento, papel ou vínculo de workspace
      // (linkedWorkspaceId é gravado apenas pelo servidor via Admin SDK).
      allow update: if isSignedIn() && isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedKeys().concat(['plan', 'paymentStatus']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionStatus'])
            || request.resource.data.subscriptionStatus == 'pending_verification');
      allow delete: if false;
    }

    // Permite que o cliente aprovador vinculado acesse e atualize a subcoleção posts do workspace
    match /users/{userId}/posts/{postId} {
      allow read: if isSignedIn() && (isOwner(userId) || isLinkedApprover(userId));
      allow update: if isSignedIn() && (isOwner(userId) || isLinkedApprover(userId));
      allow create, delete: if isSignedIn() && isOwner(userId);
    }

    // Permite que usuários autenticados acessem suas próprias subcoleções autorizadas
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if isSignedIn() && isOwner(userId) && isAllowedCollection(collection);
    }

    // Suporte a subcoleções aninhadas de subcoleções autorizadas (ex: agendamentos, rascunhos)
    match /users/{userId}/{collection}/{docId}/{subCollection}/{subDocId} {
      allow read, write: if isSignedIn() && isOwner(userId) && isAllowedCollection(collection);
    }

    // Funções auxiliares
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isLinkedApprover(userId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedWorkspaceId == userId;
    }
    
    function privilegedKeys() {
      return ['role', 'isAdmin', 'isSuperAdmin', 'tier', 'status', 'linkedWorkspaceId', 'conciergeRole'];
    }

    function isAllowedCollection(collection) {
      return collection in ['posts', 'connections', 'business', 'appData', 'contacts', 'mediaGallery', 'history', 'campaigns'];
    }
  }
}


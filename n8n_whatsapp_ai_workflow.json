    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WHATSAPP_API_URL || 'https://api.evolution.com/message/sendText' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.WHATSAPP_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\\n  \\\"number\\\": \\\"{{ $json.phone }}\\\",\\n  \\\"text\\\": \\\"{{ $json.replyText }}\\\"\\n}",
        "options": {}
      },
      "id": "node-send-whatsapp",
      "name": "Enviar Resposta no WhatsApp",
